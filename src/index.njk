---
layout: layouts/base.njk
title: Home
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Personal Introduction -->
    <div class="pt-16 pb-12 text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-100 mb-6">
            Hey, I'm J Nakano
        </h1>
        <div class="text-xl sm:text-2xl text-gray-300 h-12 flex items-center justify-center">
            <span id="typing-text" class="border-r-2 border-blue-400 pr-1"></span>
        </div>
    </div>

    <!-- Blog Section -->
    <section class="py-16 border-t border-gray-800/50">
        <div class="flex items-center justify-between mb-12">
            <h2 class="text-3xl font-bold text-gray-100">Latest Blog Posts</h2>
            <a href="/blog/" class="text-blue-400 hover:text-blue-300 transition-colors font-medium">
                View all posts →
            </a>
        </div>

        {% if collections.posts.length > 0 %}
            <div class="grid gap-8 md:grid-cols-2">
                {% for post in collections.posts | reverse | limit(4) %}
                    <article class="card-dark spotlight-effect group">
                        <div class="p-6">
                            <header class="mb-4">
                                <h3 class="text-xl font-semibold text-gray-100 mb-2 group-hover:text-blue-400 transition-colors">
                                    <a href="{{ post.url }}">{{ post.data.title }}</a>
                                </h3>
                                <div class="flex items-center text-gray-500 text-sm">
                                    <time datetime="{{ post.date | htmlDateString }}">
                                        {{ post.date | readableDate }}
                                    </time>
                                    {% if post.data.tags %}
                                        <span class="mx-2">•</span>
                                        <div class="flex flex-wrap gap-1">
                                            {% for tag in post.data.tags %}
                                                {% if tag != "post" %}
                                                    <span class="inline-block bg-gray-800 text-gray-400 px-2 py-1 rounded-full text-xs">
                                                        {{ tag }}
                                                    </span>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </header>
                            
                            {% if post.data.excerpt %}
                                <p class="text-gray-400 text-sm leading-relaxed mb-4">
                                    {{ post.data.excerpt }}
                                </p>
                            {% endif %}
                            
                            <footer>
                                <a href="{{ post.url }}" class="inline-flex items-center text-blue-400 hover:text-blue-300 font-medium transition-colors text-sm">
                                    Read more
                                    <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </a>
                            </footer>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-12 card-dark">
                <div class="text-4xl mb-4">📝</div>
                <h3 class="text-xl font-semibold text-gray-300 mb-2">No posts yet</h3>
                <p class="text-gray-500">Check back soon for new content!</p>
            </div>
        {% endif %}
    </section>

