<header class="bg-gray-950/80 backdrop-blur-strong border-b border-gray-800/50 sticky top-0 z-40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-6">
            <!-- Site Title -->
            <div class="flex-shrink-0">
                <a href="/" class="text-2xl font-bold text-gray-100 link-spotlight">
                    {{ site.title }}
                </a>
            </div>
            
            <!-- Navigation -->
            <nav class="hidden md:flex space-x-8">
                <a href="/" 
                   class="nav-link {% if page.url == '/' %}active{% endif %}">
                    Home
                </a>
                <a href="/about/" 
                   class="nav-link {% if page.url == '/about/' %}active{% endif %}">
                    About
                </a>
                <a href="/blog/" 
                   class="nav-link {% if page.url == '/blog/' or page.url.startsWith('/posts/') %}active{% endif %}">
                    Blog
                </a>
            </nav>
            
            <!-- Mobile menu button -->
            <div class="md:hidden">
                <button type="button" 
                        class="text-gray-300 hover:text-gray-100 focus:outline-none focus:text-gray-100 transition-colors spotlight-effect p-2 rounded-lg" 
                        aria-label="Toggle menu"
                        id="mobile-menu-button">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
        
        <!-- Mobile menu -->
        <div class="md:hidden border-t border-gray-800/50 py-4 hidden" id="mobile-menu">
            <div class="flex flex-col space-y-3">
                <a href="/" 
                   class="nav-link {% if page.url == '/' %}active{% endif %} text-base">
                    Home
                </a>
                <a href="/about/" 
                   class="nav-link {% if page.url == '/about/' %}active{% endif %} text-base">
                    About
                </a>
                <a href="/blog/" 
                   class="nav-link {% if page.url == '/blog/' or page.url.startsWith('/posts/') %}active{% endif %} text-base">
                    Blog
                </a>
            </div>
        </div>
    </div>
</header> 