<header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-6">
            <!-- Site Title -->
            <div class="flex-shrink-0">
                <a href="/" class="text-2xl font-bold text-gray-900 hover:text-blue-600 transition-colors">
                    {{ site.title }}
                </a>
            </div>
            
            <!-- Navigation -->
            <nav class="hidden md:flex space-x-8">
                <a href="/" 
                   class="{% if page.url == '/' %}text-blue-600 border-b-2 border-blue-600{% else %}text-gray-700 hover:text-blue-600{% endif %} pb-1 transition-colors">
                    Home
                </a>
                <a href="/about/" 
                   class="{% if page.url == '/about/' %}text-blue-600 border-b-2 border-blue-600{% else %}text-gray-700 hover:text-blue-600{% endif %} pb-1 transition-colors">
                    About
                </a>
                <a href="/blog/" 
                   class="{% if page.url == '/blog/' or page.url.startsWith('/posts/') %}text-blue-600 border-b-2 border-blue-600{% else %}text-gray-700 hover:text-blue-600{% endif %} pb-1 transition-colors">
                    Blog
                </a>
            </nav>
            
            <!-- Mobile menu button -->
            <div class="md:hidden">
                <button type="button" class="text-gray-700 hover:text-blue-600 focus:outline-none focus:text-blue-600" aria-label="Toggle menu">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
        
        <!-- Mobile menu -->
        <div class="hidden border-t border-gray-200 py-4">  <!-- TODO: Add JS to toggle this menu -->
            <div class="flex flex-col space-y-3">
                <a href="/" 
                   class="{% if page.url == '/' %}text-blue-600 font-semibold{% else %}text-gray-700 hover:text-blue-600{% endif %} transition-colors">
                    Home
                </a>
                <a href="/about/" 
                   class="{% if page.url == '/about/' %}text-blue-600 font-semibold{% else %}text-gray-700 hover:text-blue-600{% endif %} transition-colors">
                    About
                </a>
                <a href="/blog/" 
                   class="{% if page.url == '/blog/' or page.url.startsWith('/posts/') %}text-blue-600 font-semibold{% else %}text-gray-700 hover:text-blue-600{% endif %} transition-colors">
                    Blog
                </a>
            </div>
        </div>
    </div>
</header> 