<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- set pageTitle = (title + " | " + site.author) if title else (site.author + " — Developer & Writer") -%}
    {%- set pageDescription = description or excerpt or site.description %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <meta name="author" content="{{ site.author }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="{% if tags and 'post' in tags %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:site_name" content="{{ site.author }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">

    <!-- Structured data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      {% if tags and 'post' in tags -%}
      "@type": "BlogPosting",
      "headline": {{ title | dump | safe }},
      "description": {{ pageDescription | dump | safe }},
      "datePublished": "{{ page.date | htmlDateString }}",
      "url": "{{ site.url }}{{ page.url }}",
      "author": {
        "@type": "Person",
        "name": "{{ site.author }}",
        "url": "{{ site.url }}/"
      }
      {%- else -%}
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}/",
      "email": "mailto:{{ site.authorEmail }}",
      "jobTitle": "AI Architect"
      {%- endif %}
    }
    </script>

    <!-- Preconnect to optimize font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Inter font for clean, modern typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/assets/css/styles.css">
    <link rel="alternate" type="application/atom+xml" title="RSS Feed for {{ site.title }}" href="/feed.xml">
    
    <!-- Theme meta tags -->
    <meta name="theme-color" content="#0a0a0a">
    <meta name="color-scheme" content="dark">
</head>
<body class="bg-gray-950 text-gray-100 font-inter antialiased overflow-x-hidden">
    <!-- Skip to main content link for accessibility -->
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-500 text-white px-4 py-2 rounded-lg z-50 transition-all duration-300 hover:bg-blue-400 spotlight-effect">
        Skip to main content
    </a>
    
    {% include "partials/header.njk" %}
    
    <main id="main" class="min-h-screen relative">
        {{ content | safe }}
    </main>
    
    {% include "partials/footer.njk" %}
    
    <script src="/assets/js/main.js"></script>
</body>
</html> 