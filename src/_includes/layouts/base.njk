<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    
    <!-- Preconnect to optimize font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Inter font for clean, modern typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/assets/css/styles.css">
    <link rel="alternate" type="application/atom+xml" title="RSS Feed for {{ site.title }}" href="/feed.xml">
    
    <!-- Theme meta tags -->
    <meta name="theme-color" content="#0a0a0a">
    <meta name="color-scheme" content="dark">
</head>
<body class="bg-gray-950 text-gray-100 font-inter antialiased overflow-x-hidden">
    <!-- Skip to main content link for accessibility -->
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-500 text-white px-4 py-2 rounded-lg z-50 transition-all duration-300 hover:bg-blue-400 spotlight-effect">
        Skip to main content
    </a>
    
    {% include "partials/header.njk" %}
    
    <main id="main" class="min-h-screen relative">
        {{ content | safe }}
    </main>
    
    {% include "partials/footer.njk" %}
    
    <script src="/assets/js/main.js"></script>
</body>
</html> 